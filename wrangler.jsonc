{
  "name": "oddlottrading",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/blog/item-*"]
  },
  // Hourly eBay sync (7 minutes past the hour)
  "triggers": { "crons": ["7 * * * *"] },
  "kv_namespaces": [{ "binding": "OLT", "id": "048d341929c249aa90b72bdc68d7e7dc" }],
  "vars": {
    "EBAY_SELLER": "oddlottrading",
    "EBAY_MARKETPLACE": "EBAY_US",
    "EBAY_CLIENT_ID": "Nicholas-OddLotTr-PRD-a0972a5de-ba2695c7"
  }
  // Secrets (set in the Cloudflare dashboard, never committed): EBAY_CLIENT_SECRET, optional REFRESH_KEY
}
